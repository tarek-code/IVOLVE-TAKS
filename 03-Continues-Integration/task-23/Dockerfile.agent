# Custom Jenkins Agent Image with All Required Tools
# Build this image and use it in Kubernetes Plugin pod template
#
# This image includes:
# - Maven (for building Java apps)
# - kubectl (for deploying to Kubernetes)
# - Trivy (for scanning Docker images)
# - curl, wget, gnupg, lsb-release (supporting tools)
#
# Note: Docker CLI is NOT included in this image because it's mounted
# from the host node via volume mounts in jenkins-agent-config.yaml
#
# See INSTALL-TOOLS.md for build and usage instructions

FROM jenkins/inbound-agent:latest

USER root

# Install required packages
RUN apt-get update && \
    apt-get install -y \
    curl \
    ca-certificates \
    maven \
    wget \
    gnupg \
    lsb-release \
    && rm -rf /var/lib/apt/lists/*

# Install kubectl
RUN curl -LO "https://dl.k8s.io/release/$(curl -L -s https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl" && \
    chmod +x kubectl && \
    mv kubectl /usr/local/bin/kubectl && \
    kubectl version --client

# Install Trivy (for image scanning)
RUN wget -qO- https://aquasecurity.github.io/trivy-repo/deb/public.key | apt-key add - && \
    echo "deb https://aquasecurity.github.io/trivy-repo/deb $(lsb_release -sc) main" | tee -a /etc/apt/sources.list.d/trivy.list && \
    apt-get update && \
    apt-get install -y trivy && \
    trivy --version

# Verify installations
RUN mvn -version && \
    kubectl version --client && \
    trivy --version

USER jenkins

# Set working directory
WORKDIR /home/jenkins/agent
